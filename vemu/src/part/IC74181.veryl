/// 74HC181: 4-bit Arithmetic Logic Unit
///   Active-High Data convention (datasheet Table 1) を採用。
///   M=1: ロジック演算、M=0: 算術演算 (nCn=0 で +1 の carry-in 効果)。
///
///   ピン名は datasheet 準拠 (overline は active-low、先頭 `n` で表現):
///     A[3:0], B[3:0] : オペランド
///     S[3:0]         : function select
///     M              : mode (1=logic, 0=arith)
///     nCn            : carry-in (active-low, datasheet ~Cn)
///     F[3:0]         : function output
///     nCn4           : carry-out (datasheet ~Cn+4)。nCn4 → 次段 nCn の
///                      直結リップル接続が加減算共通で成立する。
///     nG             : group generate (active-low)
///     nP             : group propagate (active-low)
///                      ※ nG/nP は加算 (A plus B) 基準の簡略モデル。
///                        74182 lookahead は加算でのみ使用可。
///     AeqB           : A=B 出力 (F=1111 のとき H)
pub module IC74181 (
    A   : input  logic<4>,
    B   : input  logic<4>,
    S   : input  logic<4>,
    M   : input  logic   ,
    nCn : input  logic   ,
    F   : output logic<4>,
    nCn4: output logic   ,
    nG  : output logic   ,
    nP  : output logic   ,
    AeqB: output logic   ,
) {
    function logic_f (
        s: input logic<4>,
        a: input logic<4>,
        b: input logic<4>,
    ) -> logic<4> {
        case s {
            4'b0000 : return ~a;
            4'b0001 : return ~(a | b);
            4'b0010 : return ~a & b;
            4'b0011 : return 4'b0000;
            4'b0100 : return ~(a & b);
            4'b0101 : return ~b;
            4'b0110 : return a ^ b;
            4'b0111 : return a & ~b;
            4'b1000 : return ~a | b;
            4'b1001 : return ~(a ^ b);
            4'b1010 : return b;
            4'b1011 : return a & b;
            4'b1100 : return 4'b1111;
            4'b1101 : return a | ~b;
            4'b1110 : return a | b;
            4'b1111 : return a;
            default : return 4'b0000;
        }
    }

    /// 算術演算は全行を「4bit 量2つ + ci の加算」に正規化する。
    /// "minus 1" / "minus B" は 4'b1111 / ~b (2の補数表現) の加算として
    /// 扱うことで、減算でも nCn4 = ~carry が成立し、nCn4 → 次段 nCn の
    /// 直結リップル接続が加減算共通で実チップ同様に機能する。
    function arith_f (
        s : input logic<4>,
        a : input logic<4>,
        b : input logic<4>,
        ci: input logic   ,
    ) -> logic<5> {
        case s {
            4'b0000 : return {1'b0, a            } + {4'b0, ci};
            4'b0001 : return {1'b0, a | b        } + {4'b0, ci};
            4'b0010 : return {1'b0, a | ~b       } + {4'b0, ci};
            4'b0011 : return {1'b0, 4'b1111      } + {4'b0, ci};
            4'b0100 : return {1'b0, a            } + {1'b0, a & ~b } + {4'b0, ci};
            4'b0101 : return {1'b0, a | b        } + {1'b0, a & ~b } + {4'b0, ci};
            4'b0110 : return {1'b0, a            } + {1'b0, ~b     } + {4'b0, ci};
            4'b0111 : return {1'b0, a & ~b       } + {1'b0, 4'b1111} + {4'b0, ci};
            4'b1000 : return {1'b0, a            } + {1'b0, a & b  } + {4'b0, ci};
            4'b1001 : return {1'b0, a            } + {1'b0, b      } + {4'b0, ci};
            4'b1010 : return {1'b0, a | ~b       } + {1'b0, a & b  } + {4'b0, ci};
            4'b1011 : return {1'b0, a & b        } + {1'b0, 4'b1111} + {4'b0, ci};
            4'b1100 : return {1'b0, a            } + {1'b0, a      } + {4'b0, ci};
            4'b1101 : return {1'b0, a | b        } + {1'b0, a      } + {4'b0, ci};
            4'b1110 : return {1'b0, a | ~b       } + {1'b0, a      } + {4'b0, ci};
            4'b1111 : return {1'b0, a            } + {1'b0, 4'b1111} + {4'b0, ci};
            default : return 5'b00000;
        }
    }

    var f_l  : logic<4>;
    var f_a  : logic<5>;
    var cin  : logic;
    var f_out: logic<4>;

    assign cin   = ~nCn;
    assign f_l   = logic_f(S, A, B);
    assign f_a   = arith_f(S, A, B, cin);
    assign f_out = if M == 1'b1 ? f_l : f_a[3:0];

    assign F    = f_out;
    assign nCn4 = ~f_a[4];

    // Generate / Propagate (active-low)
    var gi: logic<4>;
    var pi: logic<4>;
    assign gi = A & B;
    assign pi = A | B;
    assign nG = ~(gi[3] | (pi[3] & gi[2]) | (pi[3] & pi[2] & gi[1]) | (pi[3] & pi[2] & pi[1] & gi[0]));
    assign nP = ~(pi[3] & pi[2] & pi[1] & pi[0]);

    assign AeqB = &f_out;
}

#[test(test_IC74181)]
module test_IC74181 {
    var A   : logic<4>;
    var B   : logic<4>;
    var S   : logic<4>;
    var M   : logic;
    var nCn : logic;
    var F   : logic<4>;
    var nCn4: logic;
    var nG  : logic;
    var nP  : logic;
    var AeqB: logic;

    inst dut: IC74181 (
        A: A, B: B, S: S, M: M, nCn: nCn,
        F: F, nCn4: nCn4, nG: nG, nP: nP, AeqB: AeqB,
    );

    initial {
        // Logic mode (M=1)
        M = 1; nCn = 1;
        // S=0110: F = A xor B
        A = 4'hA; B = 4'h5; S = 4'b0110;
        $assert(F == 4'hF);  // A xor B = 1010 ^ 0101 = 1111
        // S=1011: F = A & B
        A = 4'hC; B = 4'h6; S = 4'b1011;
        $assert(F == 4'h4);  // C & 6 = 0100
        // S=1110: F = A | B
        A = 4'hC; B = 4'h3; S = 4'b1110;
        $assert(F == 4'hF);  // C | 3 = 1111
        // S=1100: F = 1 (all-1)
        S = 4'b1100;
        $assert(F == 4'hF);
        $assert(AeqB == 1'b1);  // F=1111 のとき H

        // Arith mode (M=0)
        M = 0;
        // S=1001 (A plus B), nCn=1 (no carry)
        A = 4'h7; B = 4'h3; S = 4'b1001; nCn = 1;
        $assert(F == 4'hA);
        // nCn=0 → +1
        nCn = 0;
        $assert(F == 4'hB);

        // S=0110 (A minus B), nCn=0 → F = A - B
        S = 4'b0110; nCn = 0;
        A = 4'h7; B = 4'h3;
        $assert(F == 4'h4);
        $assert(nCn4 == 1'b0); // carry (borrow なし) → L
        A = 4'h3; B = 4'h7;
        $assert(F == 4'hC); // 3 - 7 = -4
        $assert(nCn4 == 1'b1); // borrow → H
        // S=0110, nCn=1 → F = A - B - 1。A==B で F=1111 → AeqB=H
        A = 4'h5; B = 4'h5; nCn = 1;
        $assert(F == 4'hF);
        $assert(AeqB == 1'b1);
        $assert(nCn4 == 1'b1);

        $finish();
    }
}
