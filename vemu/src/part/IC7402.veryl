/// 74HC02: Quad 2-input NOR Gate
///   A[i], B[i], Y[i] = ゲート (i+1) の 1A, 1B, 1Y (i = 0..3)。
pub module IC7402 (
    A: input  logic<4>,
    B: input  logic<4>,
    Y: output logic<4>,
) {
    assign Y = ~(A | B);
}

#[test(test_IC7402)]
module test_IC7402 {
    var A: logic<4>;
    var B: logic<4>;
    var Y: logic<4>;

    inst dut: IC7402 (
        A: A,
        B: B,
        Y: Y,
    );

    initial {
        A = 4'b0000;
        B = 4'b0000;
        $assert(Y == 4'b1111);
        A = 4'b1111;
        $assert(Y == 4'b0000);
        A = 4'b1010;
        B = 4'b0100;
        $assert(Y == 4'b0001);
        A = 4'b0000;
        B = 4'b0101;
        $assert(Y == 4'b1010);
        $finish();
    }
}
