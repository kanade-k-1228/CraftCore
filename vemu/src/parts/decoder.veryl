import arch_pkg::*;

/// 32bit命令デコーダ。リトルエンディアン:
///   bits[ 3: 0] = opcode
///   bits[ 7: 4] = rs1
///   bits[11: 8] = rs2
///   bits[15:12] = rd
///   bits[31:16] = imm
///
/// arch::op::Op::encode と整合:
///   pack(rs1,c) -> byte0,  pack(rd,rs2) -> byte1, imm LE -> byte2..3
pub module decoder (
    i_inst: input  Inst ,
    o_opc : output OpC  ,
    o_rd  : output RegId,
    o_rs1 : output RegId,
    o_rs2 : output RegId,
    o_alu : output ALU  ,
    o_imm : output Word ,
) {
    assign o_opc = i_inst[3:0] as OpC;
    assign o_rs1 = i_inst[7:4];
    assign o_rs2 = i_inst[11:8];
    assign o_rd  = i_inst[15:12];
    assign o_imm = i_inst[31:16];

    // ALU 種別の取得先は命令種別で異なる:
    //   CALC  : imm の下位4bit (encode 時に alu as u16 を imm に詰めている)
    //   CALCI : rs2 フィールド (encode: pack(rd, a as u8) -> byte1)
    //   その他: ADD 固定 (使われない)
    always_comb {
        case i_inst[3:0] as OpC {
            OpC::CALC : o_alu = i_inst[19:16] as ALU;
            OpC::CALCI: o_alu = i_inst[11:8]  as ALU;
            default   : o_alu = ALU::ADD;
        }
    }
}
