#[test(test_alu_basic)]
embed (inline) sv{{{
module test_alu_basic;
  import vemu_arch_pkg::*;

  ALU         op;
  logic [15:0] a;
  logic [15:0] b;
  logic [15:0] y;

  vemu_alu u_dut (
    .i_op (op),
    .i_a  (a ),
    .i_b  (b ),
    .o_y  (y )
  );

  task automatic check(
    input string         name,
    input ALU            op_in,
    input logic [15:0]   a_in,
    input logic [15:0]   b_in,
    input logic [15:0]   exp
  );
    op = op_in; a = a_in; b = b_in;
    #1;
    assert (y === exp)
    else $error("FAIL %s op=%0d a=%h b=%h y=%h exp=%h", name, op_in, a_in, b_in, y, exp);
  endtask

  initial begin
    // arith
    check("ADD wrap",  ALU_ADD, 16'hFFFF, 16'h0001, 16'h0000);
    check("ADD",       ALU_ADD, 16'h1234, 16'h0010, 16'h1244);
    check("SUB",       ALU_SUB, 16'h0005, 16'h0003, 16'h0002);
    check("SUB wrap",  ALU_SUB, 16'h0000, 16'h0001, 16'hFFFF);

    // logic
    check("AND",       ALU_AND, 16'hF0F0, 16'h0FF0, 16'h00F0);
    check("OR",        ALU_OR,  16'hF000, 16'h00F0, 16'hF0F0);
    check("XOR",       ALU_XOR, 16'hFF00, 16'h0FF0, 16'hF0F0);

    // compare (unsigned)
    check("EQ true",   ALU_EQ,  16'h1234, 16'h1234, 16'hFFFF);
    check("EQ false",  ALU_EQ,  16'h1234, 16'h1235, 16'h0000);
    check("NEQ true",  ALU_NEQ, 16'h1234, 16'h1235, 16'hFFFF);
    check("NEQ false", ALU_NEQ, 16'h1234, 16'h1234, 16'h0000);
    check("LT true",   ALU_LT,  16'h0001, 16'h0002, 16'hFFFF);
    check("LT false",  ALU_LT,  16'hFFFE, 16'h0001, 16'h0000); // unsigned

    // compare (signed)
    check("LTS true",  ALU_LTS, 16'hFFFE, 16'h0001, 16'hFFFF); // -2 < 1
    check("LTS false", ALU_LTS, 16'h0001, 16'hFFFE, 16'h0000); // 1 not < -2

    // shift
    check("SR",        ALU_SR,  16'h8001, 16'h0000, 16'h4000);
    check("SRS pos",   ALU_SRS, 16'h4002, 16'h0000, 16'h2001);
    check("SRS neg",   ALU_SRS, 16'h8002, 16'h0000, 16'hC001); // sign-extend
    check("SRR",       ALU_SRR, 16'h0001, 16'h0000, 16'h8000); // rotate
    check("SL",        ALU_SL,  16'h4001, 16'h0000, 16'h8002);
    check("SLR",       ALU_SLR, 16'h8001, 16'h0000, 16'h0003); // rotate

    $display("test_alu_basic: all checks passed");
    $finish;
  end
endmodule
}}}
