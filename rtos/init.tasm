// ============================================================
// init.tasm — 起動・終了・割り込みベクタ
// ============================================================

// --------------------------------------------------------
// 割り込みベクタ

asm @ 0x0000 reset {
    // 新 ABI: SP が唯一のスタックポインタ (Arg[0]=SP+0, saved RA=SP+2)。
    loadi(sp, 0xffff);
    call(init);
  halt:
    jumpr(halt);
}

asm @ 0x0004 irq {
    jump(rtos::task::_intr);
}

// --------------------------------------------------------
// メモリレイアウト定数
//
// アーキテクチャ仕様に従い固定アドレスに配置する。

const os_global_size = 8;
const mem_top    = 0x0040;
const mem_bottom = 0xdfff;

// --------------------------------------------------------
// システム制御レジスタ
//
// CSR はレジスタ (slot #3) で、`csr` という識別子で読み書きできる。
// コンパイラが自動的に MOV/AND/OR 命令へ展開する。

// CSR の制御ビット
const clock_stop = 0x0100; // CPU クロック停止

// --------------------------------------------------------
// OS の初期化処理

fn init() {
    // ヒープの初期化
    rtos::heap::heap_top    = (mem_top + os_global_size + user_global_size) as *int;
    rtos::heap::heap_bottom = mem_bottom as *int;

    // タスク管理構造の初期化
    rtos::task::task_running = 0 as *rtos::task::TCB;
    rtos::task::task_list    = 0 as *rtos::task::TCB;

    // 各種オブジェクトの初期化
    init_tasks();

    // スケジューラを起動
    rtos::task::os_task_scheduler();
}

// --------------------------------------------------------
// 終了処理
//
// 全タスクが exit すると scheduler から `jump(_exit)` で呼ばれる。
// `jump` で来るので fn の prologue 経由ではなく asm で書く必要がある
// (= prologue で立てた callee frame を持っていないので epilogue で
//  ret したら戻り先がデタラメになる)。
asm _exit {
    ori(csr, csr, clock_stop);  // CPU クロックを止める
  halt:
    jumpr(halt);                // 念のため無限ループで halt 状態を維持
}
