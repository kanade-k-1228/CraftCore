// ============================================================
// heap.tasm — ヒープメモリ管理
// ============================================================

// ヒープ管理用のポインタは固定アドレスに置く
static @ 0x0040 heap_top    : *int;  // ヒープメモリの先頭
static @ 0x0041 heap_bottom : *int;  // ヒープメモリの末尾

// 単純な bump allocator
fn malloc(size: int) -> *int {
    var addr: *int = heap_top;
    heap_top = (addr as int + size) as *int;
    return addr;
}

