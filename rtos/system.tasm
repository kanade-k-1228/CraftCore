// --------------------------------------------------------
// 割り込みベクタ

asm @ 0x0000 reset {
    call(init);
  halt:
    jumpr(halt);
}

asm init {
    loadi(sp, 0xffff);
    loadi(fp, 0xffff);
    call(os_init);
}

// 割り込みベクタは 0x0004 番地（命令スロット 4 つまで）
// 実体は intr_dispatch にジャンプして処理する
asm @ 0x0004 intr {
    jump(intr_dispatch);
}

// --------------------------------------------------------
// OS グローバル変数
//
// アーキテクチャ仕様に従い固定アドレスに配置する
// （ヒープ・タスク管理用のポインタは static として扱う）

const os_global_size = 8;
const mem_top    = 0x0040;
const mem_bottom = 0xdfff;

static @ 0x0040 heap_top    : *int;  // ヒープメモリの先頭
static @ 0x0041 heap_bottom : *int;  // ヒープメモリの末尾
static @ 0x0042 task_running: *TCB;  // 実行中のタスク(TCB)のアドレス
static @ 0x0043 task_list   : *TCB;  // タスク(TCB)連結リストの先頭

// 割り込み制御レジスタ（メモリマップド I/O を想定）
// アドレスは実機仕様に合わせて要調整
static @ 0x0050 csr : int;

// 割り込み制御フラグ
const INTR = {
    ENABLE: 0x0001,
    MASK0:  0x0004,
    MASK1:  0x0008,
    MASK2:  0x0010,
    MASK3:  0x0020,
};

const intr0_flag = 0x0100;
const intr1_flag = 0x0200;
const intr2_flag = 0x0400;
const intr3_flag = 0x0800;

// --------------------------------------------------------
// 割り込みディスパッチャ
//
// 元実装はコンテキスト保存と割り込み番号の判定を asm 内で
// 行っていたが、新文法では asm-stmt は inst(args); 形式のみ
// 許容されるため、判定処理は高級言語関数 intr_dispatch に
// 移してある。
fn intr_dispatch() {
    // 割り込みを一旦禁止（重複割り込みの抑止）
    csr = csr & (INTR.ENABLE ^ 0xffff);

    // 割り込み要因に応じて各ハンドラを呼び出す
    if ((csr & intr0_flag) != 0) {
        intr0();
    }
    if ((csr & intr1_flag) != 0) {
        intr1();
    }
    if ((csr & intr2_flag) != 0) {
        intr2();
    }
    if ((csr & intr3_flag) != 0) {
        intr3();
    }

    // ハンドラが復帰してきた場合は中断地点に戻る
    os_restore_context();
}

// --------------------------------------------------------
// 割り込みハンドラのプレースホルダー

fn intr0() {
    // TODO: Implement interrupt 0 handler
    return;
}

fn intr1() {
    // TODO: Implement interrupt 1 handler
    return;
}

fn intr2() {
    // TODO: Implement interrupt 2 handler
    return;
}

fn intr3() {
    // TODO: Implement interrupt 3 handler
    return;
