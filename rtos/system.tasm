// --------------------------------------------------------
// OS の初期化処理

// ユーザコード側で定義されることを期待するプレースホルダー
const user_global_size = 0;

fn init_tasks() {
    // TODO: ユーザ側でオーバーライドしてタスクを生成する
    return;
}

fn _exit() {
    // halt 相当: 永久ループ
    while (1) {
        return;
    }
}

// 単純な bump allocator
fn malloc(size: int) -> *int {
    var addr: *int = heap_top;
    heap_top = (addr as int + size) as *int;
    return addr;
}

fn os_init() {
    // ヒープの初期化
    heap_top    = (mem_top + os_global_size + user_global_size) as *int;
    heap_bottom = mem_bottom as *int;

    // タスク管理構造の初期化
    task_running = 0 as *TCB;
    task_list    = 0 as *TCB;

    // 各種オブジェクトの初期化
    init_tasks();

    // スケジューラを起動
    os_task_scheduler();
}

