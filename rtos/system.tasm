// --------------------------------------------------------
// タスク管理機能

// Task Context Block
// next フィールドは自己参照を避けるため *void として持つ
// （現コンパイラは type-def の自己参照を正規化できない）
type TCB = {
    next:  *void, // 次のタスク（実体は *TCB、cast で復元する）
    sp:    *int,  // スタックポインタ
    bp:    *int,  // ベースポインタ
    ra:    *int,  // 戻りアドレス
    state: int,   // タスクの状態
};

// Task state constants
const task_state_ready   = 0;
const task_state_waiting = 1;
const task_state_exit    = 2;

// タスクの初期化
fn os_task_setup(
    initial_state: int,             // タスクの初期状態
    stack_size:    int,             // スタックサイズ
    entry_address: *() -> int,      // 関数ポインタ
) -> *TCB {
    // タスクリストの末尾を探す
    var last: *TCB = task_list;
    while (last != (0 as *TCB)) {
        last = (@last).next as *TCB;
    }

    // 新しい TCB と専用スタックを確保
    var new_tcb: *TCB = malloc(sizeof<TCB>) as *TCB;
    var new_stack: *int = malloc(stack_size);

    (@last).next = new_tcb as *void;
    @new_tcb = {
        next:  0 as *void,
        sp:    (new_stack as int - 14) as *int,
        bp:    (new_stack as int + stack_size) as *int,
        ra:    entry_address as *int,
        state: initial_state,
    };

    // 初期コンテキスト分のスタック領域を 0 で初期化
    new_stack[12] = 0; // s0
    new_stack[11] = 0; // s1
    new_stack[10] = 0; // s2
    new_stack[9]  = 0; // s3
    new_stack[8]  = 0; // t0
    new_stack[7]  = 0; // t1
    new_stack[6]  = 0; // t2
    new_stack[5]  = 0; // t3
    new_stack[4]  = 0; // a0
    new_stack[3]  = 0; // a1
    new_stack[2]  = 0; // fp
    new_stack[1]  = os_task_exit as int;
    return new_tcb;
}

// タスクの終了
fn os_task_exit() {
    csr = csr & 0xfffe; // 割り込み禁止
    var tcb: *TCB = task_running;
    (@tcb).state = task_state_exit;
    os_task_scheduler();
}

// 実行中のタスクを一時停止
fn os_task_wait() {
    csr = csr & 0xfffe; // 割り込み禁止

    // コンテキストの保存（s0..s3, t0..t3, a0, a1, fp, ra の計 12 個）
    sp = sp - 12;
    store(s0, sp, 12);
    store(s1, sp, 11);
    store(s2, sp, 10);
    store(s3, sp, 9);
    store(t0, sp, 8);
    store(t1, sp, 7);
    store(t2, sp, 6);
    store(t3, sp, 5);
    store(a0, sp, 4);
    store(a1, sp, 3);
    store(fp, sp, 2);
    store(ra, sp, 1);

    // TCB の更新
    var tcb: *TCB = task_running;
    (@tcb).sp = sp as *int;
    (@tcb).ra = ra as *int;

    // 状態を waiting に変更
    (@tcb).state = task_state_waiting;
    os_task_scheduler();
}

// 指定した ID のタスクを Ready 状態にする
fn os_task_ready(task_id: *TCB) {
    csr = csr & 0xfffe; // 割り込み禁止

    // コンテキストの保存（s0..s3, t0..t3, a0, a1, fp, ra）
    sp = sp - 12;
    store(s0, sp, 12);
    store(s1, sp, 11);
    store(s2, sp, 10);
    store(s3, sp, 9);
    store(t0, sp, 8);
    store(t1, sp, 7);
    store(t2, sp, 6);
    store(t3, sp, 5);
    store(a0, sp, 4);
    store(a1, sp, 3);
    store(fp, sp, 2);
    store(ra, sp, 1);

    // 現在実行中の TCB の更新
    var tcb: *TCB = task_running;
    (@tcb).sp = sp as *int;
    (@tcb).ra = ra as *int;

    // 指定されたタスクの状態を ready に変更
    (@task_id).state = task_state_ready;
    os_task_scheduler();
}

fn os_task_scheduler() {
    // タスクリストから Ready 状態のタスクを探す
    var cur: *TCB = task_list;

    while (cur != (0 as *TCB)) {
        if ((@cur).state == task_state_ready) {
            task_running = cur;
            os_restore_context();
            return;
        }
        cur = (@cur).next as *TCB;
    }

    // Ready 状態のタスクが見つからなかった（全て exit）
    _exit();
}

fn os_restore_context() {
    // タスクを再開
    var tcb: *TCB = task_running;
    sp  = (@tcb).sp as int;     // スタックポインタを復元
    ira = (@tcb).ra as int;     // 戻りアドレスを IRA に復元

    // レジスタをスタックから復元
    ra = load(sp, 1);
    fp = load(sp, 2);
    a1 = load(sp, 3);
    a0 = load(sp, 4);
    t3 = load(sp, 5);
    t2 = load(sp, 6);
    t1 = load(sp, 7);
    t0 = load(sp, 8);
    s3 = load(sp, 9);
    s2 = load(sp, 10);
    s1 = load(sp, 11);
    s0 = load(sp, 12);

    sp  = sp + 12;          // スタックを解放
    csr = csr | INTR.ENABLE; // 割り込み許可
    iret();                  // 中断地点に戻る
}

