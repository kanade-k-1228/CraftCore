// 08_semaphore — カウンティングセマフォによる producer-consumer
//
// 1 スロットのバッファを empty/full の 2 つのセマフォで同期する古典的構成。
//   empty (初期 1) : 空きスロット数
//   full  (初期 0) : 充填済みスロット数
// producer は empty を待って値を書き full を上げる。consumer は full を待って
// 値を読み empty を上げる。1 スロットなので producer/consumer は厳密に交互実行になる。
// 期待出力: P0 C0 P1 C1 ... P4 C4 (各行)。

const user_global_size = 5;

static @ 0x0044 task_id_p : *rtos::task::TCB;
static @ 0x0045 task_id_c : *rtos::task::TCB;
static @ 0x0046 sem_empty : *rtos::task::Sem;   // 空きスロット数 (初期 1)
static @ 0x0047 sem_full  : *rtos::task::Sem;   // 充填スロット数 (初期 0)
static @ 0x0048 buffer    : int;    // 1 word バッファ

// 本サンプルは協調スケジュール (タイマ割込は使わない)
fn intr0() { return; }
fn intr1() { return; }
fn intr2() { return; }
fn intr3() { return; }

fn producer() {
    var i: int = 0;
    while (i < 5) {
        rtos::task::os_sem_wait(sem_empty);     // 空きスロットを待つ
        buffer = i;
        rtos::serial::print_char('P');
        rtos::serial::print_char(i + '0');
        rtos::serial::print_char('\n');
        rtos::task::os_sem_signal(sem_full);    // 充填を通知 (consumer を起こす)
        i = i + 1;
    }
    rtos::task::os_task_exit();
}

fn consumer() {
    var i: int = 0;
    while (i < 5) {
        rtos::task::os_sem_wait(sem_full);      // 充填を待つ
        rtos::serial::print_char('C');
        rtos::serial::print_char(buffer + '0');
        rtos::serial::print_char('\n');
        rtos::task::os_sem_signal(sem_empty);   // 空きを通知 (producer を起こす)
        i = i + 1;
    }
    rtos::task::os_task_exit();
}

fn init_tasks() {
    sem_empty = rtos::task::os_sem_init(1);
    sem_full  = rtos::task::os_sem_init(0);
    task_id_p = rtos::task::os_task_setup(rtos::task::task_state_ready, 0x100, producer as int);
    task_id_c = rtos::task::os_task_setup(rtos::task::task_state_ready, 0x100, consumer as int);
}
