static @ 0x1000 serial_tx : int;

asm @ 0x0000 reset {
    jump(main);
}

asm main {
    loadi(t2, 'H');
    store(t2, z, serial_tx@);
    loadi(t2, 'e');
    store(t2, z, serial_tx@);
    loadi(t2, 'l');
    store(t2, z, serial_tx@);
    loadi(t2, 'l');
    store(t2, z, serial_tx@);
    loadi(t2, 'o');
    store(t2, z, serial_tx@);
    loadi(t2, ' ');
    store(t2, z, serial_tx@);
    loadi(t2, 'W');
    store(t2, z, serial_tx@);
    loadi(t2, 'o');
    store(t2, z, serial_tx@);
    loadi(t2, 'r');
    store(t2, z, serial_tx@);
    loadi(t2, 'l');
    store(t2, z, serial_tx@);
    loadi(t2, 'd');
    store(t2, z, serial_tx@);
    loadi(t2, '!');
    store(t2, z, serial_tx@);
    loadi(t2, '\n');
    store(t2, z, serial_tx@);
    jump(main);
}
