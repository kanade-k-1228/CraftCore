// This is a sample code for rk16 assembly

static hoge : int;
static fuga : int;
static piyo : int;
static foo : int;
static bar : int;
static exit : int;

const cst = 0x0123;

asm @ 0x0008 reset {
    add(t4, t2, t3);
    sub(t4, t2, t3);
    and(t4, t2, t3);
    or(t4, t2, t3);
    xor(t4, t2, t3);

    eq(t4, t2, t3);
    neq(t4, t2, t3);
    lt(t4, t2, t3);
    lts(t4, t2, t3);

    sr(t4, t2);
    srs(t4, t2);
    srr(t4, t2);
    sl(t4, t2);
    slr(t4, t2);

    nop();
    mov(t6, t7);

    addi(t4, t2, cst);
    subi(t4, t2, hoge@);
    andi(t4, t2, fuga@);
    ori(t4, t2, 0x0000);
    xori(t4, t2, 0x0110);

    eqi(t4, t2, 0x1100);
    neqi(t4, t2, 0x1100);
    lti(t4, t2, 0xf000);
    ltsi(t4, t2, 0xf000);

    not(t4, t2);
    loadi(t2, 0x0123);

    load(t4, t2, hoge@);
    store(t4, t2, fuga@);

  a:
    jumpif(t3, reset);
    jumpifr(t3, b);
    jump(reset);
    jumpr(b);
  b:
    call(reset);
  c:
    ret();
  d:
    iret();
  e:
    jumpr(e);
}
