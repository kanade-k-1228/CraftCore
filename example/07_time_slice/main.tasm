// 01_time_slice — 3 タスク X/Y/Z を intr0 で時分割実行
//
// intr0 が来るたびに rtos::task::task_list を 1 つだけ回転させる:
//   [head, A, B, tail]  →  [A, B, tail, head]
// scheduler は list 先頭から ready を探すので、回転で別タスクが選ばれる。
//
// 各タスクは "X:hex\n" を 10 回 print してから exit する。

const user_global_size = 3;

static @ 0x0048 task_id_x : *rtos::task::TCB;
static @ 0x0049 task_id_y : *rtos::task::TCB;
static @ 0x004A task_id_z : *rtos::task::TCB;

const s_switch = "<SwitchTask>\n";
const s_label_x = "X:";
const s_label_y = "Y:";
const s_label_z = "Z:";
const s_newline = "\n";

// 1 命令スロットで完結する asm では難しいので、ローテートは intr0() fn で書く
fn intr0() {
    rtos::serial::print_str(s_switch@ as *int);

    // rtos::task::task_list が空 / 単一なら回転しない
    if (rtos::task::task_list != (0 as *rtos::task::TCB)) {
        var head: *rtos::task::TCB = rtos::task::task_list;
        var second: *rtos::task::TCB = (@head).next as *rtos::task::TCB;
        if (second != (0 as *rtos::task::TCB)) {
            // 末尾 tail を探す
            var tail: *rtos::task::TCB = head;
            while ((@tail).next != (0 as *void)) {
                tail = (@tail).next as *rtos::task::TCB;
            }
            // tail.next = head;  head.next = 0;  rtos::task::task_list = second;
            (@tail).next = head as *void;
            (@head).next = 0 as *void;
            rtos::task::task_list = second;
        }
    }

    // intr0 フラグをクリア (bit8 を落とす)
    csr = csr & 0xfeff;
}

fn intr1() { csr = csr & 0xfdff; }
fn intr2() { csr = csr & 0xfbff; }
fn intr3() { csr = csr & 0xf7ff; }

fn task_x() {
    var i: int = 0;
    while (i < 10) {
        rtos::serial::print_str(s_label_x@ as *int);
        rtos::serial::print_hex(i);
        rtos::serial::print_str(s_newline@ as *int);
        i = i + 1;
    }
    rtos::task::os_task_exit();
}

fn task_y() {
    var i: int = 0;
    while (i < 10) {
        rtos::serial::print_str(s_label_y@ as *int);
        rtos::serial::print_hex(i);
        rtos::serial::print_str(s_newline@ as *int);
        i = i + 1;
    }
    rtos::task::os_task_exit();
}

fn task_z() {
    var i: int = 0;
    while (i < 10) {
        rtos::serial::print_str(s_label_z@ as *int);
        rtos::serial::print_hex(i);
        rtos::serial::print_str(s_newline@ as *int);
        i = i + 1;
    }
    rtos::task::os_task_exit();
}

fn init_tasks() {
    task_id_x = rtos::task::os_task_setup(rtos::task::task_state_ready, 0x100, task_x as int);
    task_id_y = rtos::task::os_task_setup(rtos::task::task_state_ready, 0x100, task_y as int);
    task_id_z = rtos::task::os_task_setup(rtos::task::task_state_ready, 0x100, task_z as int);

    // 割り込みを許可しておく (csr の bit0)
    csr = csr | rtos::task::INTR.ENABLE;
}
