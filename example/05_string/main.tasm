static @ 0x0100 serial_tx : int;

const msg = "Hello, World!\n";

asm @ 0x0000 reset {
    jump(main);
}

asm main {
    loadi(t0, msg@);         // t0: Addr
    loadi(t1, sizeof(msg));  // t1: Size
    loadi(t2, serial_tx@);   // t2: Serial TX address
    loadi(s0, 0);            // s0: Counter

  loop:
    lt(s1, s0, t1);        // s1 = (s0 < t1): 1 if まだ送信文字あり
    eqi(s2, s1, 0);        // s2 = (s1 == 0): 送信終了なら 1
    jumpifr(s2, exit);     // jumpifr は jump-if-nonzero。s2!=0 で exit へ

    // Load char
    add(s1, t0, s0);
    load(s2, s1, 0);
    store(s2, t2, 0);

    // Increment
    addi(s0, s0, 1);
    jumpr(loop);

  exit:
    jumpr(exit);
}
