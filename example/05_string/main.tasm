static @ 0x1000 serial_tx : int;

const msg = "Hello, World!\n";

asm @ 0x0000 reset {
    jump(main);
}

asm main {
    loadi(t2, msg@);         // t2: Addr
    loadi(t3, sizeof(msg));  // t3: Size
    loadi(t4, serial_tx@);   // t4: Serial TX address
    loadi(t6, 0);            // t6: Counter

  loop:
    lt(t7, t6, t3);        // t7 = (t6 < t3): 1 if まだ送信文字あり
    eqi(t8, t7, 0);        // t8 = (t7 == 0): 送信終了なら 1
    jumpifr(t8, exit);     // jumpifr は jump-if-nonzero。t8!=0 で exit へ

    // Load char
    add(t7, t2, t6);
    load(t8, t7, 0);
    store(t8, t4, 0);

    // Increment
    addi(t6, t6, 1);
    jumpr(loop);

  exit:
    jumpr(exit);
}
