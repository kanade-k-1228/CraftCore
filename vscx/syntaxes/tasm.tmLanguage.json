{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "TASM",
  "patterns": [
    { "include": "#comments" },
    { "include": "#scope-labels" },
    { "include": "#break-continue" },
    { "include": "#asm-block" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#char-literals" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#labels" },
    { "include": "#declarations" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tasm",
          "match": "//.*$"
        }
      ]
    },
    "scope-labels": {
      "patterns": [
        {
          "name": "meta.scope-label.tasm",
          "match": "(')([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=:)",
          "captures": {
            "1": { "name": "punctuation.definition.scope-label.tasm" },
            "2": { "name": "entity.name.label.scope.tasm" }
          }
        }
      ]
    },
    "break-continue": {
      "patterns": [
        {
          "match": "\\b(break|continue)\\s+(')([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.tasm" },
            "2": { "name": "punctuation.definition.scope-label.tasm" },
            "3": { "name": "entity.name.label.scope.tasm" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tasm",
          "match": "\\b(if|else|while|return|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.tasm",
          "match": "\\b(fn|var|type|const|static)\\b"
        },
        {
          "name": "keyword.type.primitive.tasm",
          "match": "\\b(int|void)\\b"
        },
        {
          "name": "keyword.operator.word.tasm",
          "match": "\\b(as|sizeof)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.tasm",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "storage.type.pointer.tasm",
          "match": "\\*"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.tasm",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tasm",
              "match": "\\\\[\\\\\"nrt0]"
            }
          ]
        }
      ]
    },
    "char-literals": {
      "patterns": [
        {
          "name": "string.quoted.single.tasm",
          "match": "'(\\\\[\\\\nrt'\"0]|[^\\\\'])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.tasm",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.octal.tasm",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.binary.tasm",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.tasm",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.tasm",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.shift.tasm",
          "match": "<<|>>"
        },
        {
          "name": "keyword.operator.bitwise.tasm",
          "match": "[&|^]"
        },
        {
          "name": "keyword.operator.comparison.tasm",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.tasm",
          "match": "!"
        },
        {
          "name": "keyword.operator.assignment.tasm",
          "match": "="
        },
        {
          "name": "keyword.operator.arrow.tasm",
          "match": "->"
        },
        {
          "name": "keyword.operator.address.tasm",
          "match": "@"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.tasm",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.function.tasm" },
            "2": { "name": "entity.name.function.tasm" }
          }
        },
        {
          "name": "entity.name.function.call.tasm",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.tasm" }
          }
        }
      ]
    },
    "asm-block": {
      "begin": "\\b(asm)\\b\\s+(?:(@)\\s*(0[xX][0-9a-fA-F_]+|[0-9][0-9_]*)\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.assembly.tasm" },
        "2": { "name": "keyword.operator.address.tasm" },
        "3": { "name": "constant.numeric.tasm" },
        "4": { "name": "entity.name.function.tasm" },
        "5": { "name": "punctuation.section.block.begin.tasm" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.tasm" }
      },
      "name": "meta.asm-block.tasm",
      "patterns": [
        { "include": "#comments" },
        { "include": "#assembly-instructions" },
        { "include": "#registers" },
        { "include": "#numbers" },
        { "include": "#operators" },
        { "include": "#labels" },
        { "include": "#identifiers" }
      ]
    },
    "assembly-instructions": {
      "patterns": [
        {
          "name": "keyword.control.assembly.tasm",
          "match": "\\b(nop|mov|add|addi|sub|subi|load|loadi|store|jump|jumpr|jumpif|jumpifr|call|callr|ret|iret|not|and|andi|or|ori|xor|xori|eq|eqi|neq|neqi|lt|lti|lts|ltsi|sl|slr|sr|srs|srr)\\b"
        }
      ]
    },
    "registers": {
      "patterns": [
        {
          "name": "variable.language.register.tasm",
          "match": "\\b(z|zero|sp|ra|fp|a0|a1|t0|t1|t2|t3|s0|s1|s2|s3|pc)\\b"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.tasm",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*:",
          "captures": {
            "1": { "name": "entity.name.function.tasm" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(static)\\s+(@\\s*[^\\s]+\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\\s*:",
          "captures": {
            "1": { "name": "keyword.declaration.tasm" },
            "3": { "name": "variable.other.readwrite.tasm" }
          }
        },
        {
          "match": "\\b(const)\\s+(@\\s*[^\\s]+\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)\\s*=",
          "captures": {
            "1": { "name": "keyword.declaration.tasm" },
            "3": { "name": "variable.other.readwrite.tasm" }
          }
        },
        {
          "match": "\\b(type)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*=",
          "captures": {
            "1": { "name": "keyword.declaration.tasm" },
            "2": { "name": "entity.name.type.tasm" }
          }
        },
        {
          "match": "\\b(var)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*:",
          "captures": {
            "1": { "name": "keyword.declaration.tasm" },
            "2": { "name": "variable.other.readwrite.tasm" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.tasm",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  },
  "scopeName": "source.tasm"
}
